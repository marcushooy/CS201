hs_err_pid*
replay_pid*

# IDE
.vscode/
.idea/
*.iml
.DS_Store

# Results - keep folder, ignore CSV and generated files
results/*.csv
results/*.md
results/*.txt
results/*.png
!results/.gitkeep

# Remove any other results folders
bin/results/
src/main/java/results/
